# cloide-shell Nginx 站点模板
#
# 公网必须启用 HTTPS/WSS；下方 80 端口块仅用于内网联调或证书签发前临时使用。
# 只合并 server 块，不要覆盖系统/面板生成的完整 nginx.conf。
# 本模板不含前端 SPA fallback：cloide-shell 当前没有 Web 前端，根路径保持 404。

server {
    listen 80;
    server_name SERVER_IP_OR_DOMAIN;
    client_max_body_size 16m;

    # Agent 安装包与版本化 release（可选；目录按实际部署调整）
    location /agent/ {
        # 与 deploy/agent/RELEASE.md 的 /srv/cloide-agent/agent 目录保持一致。
        root /srv/cloide-agent;
        try_files $uri =404;
        default_type application/octet-stream;
        add_header Cache-Control "no-store";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:18080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OpenAPI / Swagger（prod profile 默认关闭；local/dev 或显式开启 springdoc 时可用）
    location /api-docs {
        proxy_pass http://127.0.0.1:18080/api-docs;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /swagger-ui.html {
        proxy_pass http://127.0.0.1:18080/swagger-ui.html;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /swagger-ui/ {
        proxy_pass http://127.0.0.1:18080/swagger-ui/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/agent {
        proxy_pass http://127.0.0.1:18080/ws/agent;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /ws/monitor {
        proxy_pass http://127.0.0.1:18080/ws/monitor;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# HTTPS/WSS 生产模板（有域名并签发证书后启用）：
#   1. 新建 server { listen 443 ssl; http2 on; server_name <域名>; ... }
#   2. 配置 ssl_certificate / ssl_certificate_key；
#   3. 保留上面的 location 块；
#   4. 另建 80 端口 server 做 301 跳转，并加 HSTS。
