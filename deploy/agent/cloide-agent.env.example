# cloide-shell Agent 环境变量配置文件。
#
# 部署路径：/etc/cloide/agent.env
# 修改后执行：sudo systemctl restart cloide-agent
# 敏感字段（CLOIDE_AGENT_TOKEN）不要提交到 Git。

CLOIDE_BACKEND_URL=wss://SERVER_IP_OR_DOMAIN
CLOIDE_SERVER_ID=1
CLOIDE_AGENT_TOKEN=REPLACE_WITH_YOUR_TOKEN
CLOIDE_COLLECT_INTERVAL_SECONDS=5
CLOIDE_HEARTBEAT_INTERVAL_SECONDS=30
CLOIDE_RECONNECT_INITIAL_SECONDS=5
CLOIDE_RECONNECT_MAX_SECONDS=60
# 后端须先升级到支持 metrics.ack 的版本；指标在确认前保留在本地 FIFO。
CLOIDE_METRICS_BUFFER_PATH=/var/lib/cloide/metrics-buffer.json
CLOIDE_METRICS_BUFFER_MAX_ENTRIES=720
CLOIDE_METRICS_ACK_TIMEOUT_SECONDS=15
CLOIDE_METRICS_RETRY_INITIAL_SECONDS=2
CLOIDE_METRICS_RETRY_MAX_SECONDS=60
# 积压重放的相邻发送最小间隔，避免恢复时触发服务端 metrics 限流。
CLOIDE_METRICS_REPLAY_MIN_INTERVAL_MILLIS=2500
CLOIDE_METRICS_RETRY_JITTER_ENABLED=true
CLOIDE_LOG_LEVEL=info
# 远程终端默认关闭；需要时显式改为 true。
CLOIDE_TERMINAL_ENABLED=false
CLOIDE_TERMINAL_SHELL=/bin/bash
CLOIDE_TERMINAL_MAX_SESSIONS=4
CLOIDE_TERMINAL_MAX_INPUT_BYTES=16384
CLOIDE_TERMINAL_MAX_OUTPUT_BYTES=16384
CLOIDE_TERMINAL_OUTPUT_RATE_BYTES_PER_SECOND=262144
CLOIDE_TERMINAL_OUTPUT_BURST_BYTES=524288
CLOIDE_TERMINAL_OUTPUT_QUEUE_SIZE=64
CLOIDE_TERMINAL_IDLE_TIMEOUT_SECONDS=1200
CLOIDE_TERMINAL_MAX_LIFETIME_SECONDS=28800
