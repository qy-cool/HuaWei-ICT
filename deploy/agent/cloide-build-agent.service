[Unit]
Description=Cloide project test node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloide-build
Group=cloide-build
StateDirectory=cloide-build
WorkingDirectory=/var/lib/cloide-build
EnvironmentFile=/etc/cloide/build-agent.env
Environment=CLOIDE_JOB_MANIFEST=/etc/cloide/build-jobs.json
Environment=CLOIDE_TERMINAL_ENABLED=false
Environment=CLOIDE_COMMAND_ENABLED=false
ExecStart=/usr/local/bin/cloide-agent
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/cloide-build
KillMode=control-group

[Install]
WantedBy=multi-user.target
