{
  "openapi": "3.1.0",
  "info": {
    "title": "HuaWei-ICT API",
    "description": "HuaWei-ICT 后端 REST 契约模板。新增模块时复制本文件为 openapi-{模块名}.json，再补 paths 与按需的 schema。",
    "version": "0.1.0",
    "contact": {
      "name": "HuaWei-ICT Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地开发服务器"
    },
    {
      "url": "https://{host}",
      "description": "华为云部署环境；host 替换为实际域名或 IP",
      "variables": {
        "host": {
          "default": "example.com",
          "description": "替换为华为云实际域名或 IP；示例值不指向真实服务"
        }
      }
    }
  ],
  "tags": [],
  "paths": {},
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "description": "统一响应结构，与后端 ApiResponse<T> 对齐",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer",
            "description": "业务状态码；0 或 200 表示成功"
          },
          "message": {
            "type": "string",
            "description": "面向调用方的可执行提示，不包含敏感值"
          },
          "data": {
            "description": "业务数据，按具体接口定义；3.1 不再使用 nullable"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer",
            "description": "错误码"
          },
          "message": {
            "type": "string",
            "description": "错误说明"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ]
}
