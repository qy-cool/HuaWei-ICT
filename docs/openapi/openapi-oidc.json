{
  "openapi": "3.0.3",
  "info": {
    "title": "企业 OIDC 登录",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/oidc/status": {
      "get": {
        "operationId": "getOidcStatus",
        "summary": "查询本部署是否启用企业登录",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Status"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "无法验证登录"
          },
          "403": {
            "description": "Origin、账号或管理授权不符"
          },
          "404": {
            "description": "本部署未启用或账号不存在"
          },
          "409": {
            "description": "该企业身份已绑定"
          },
          "429": {
            "description": "登录次数超过限额"
          }
        }
      }
    },
    "/api/auth/oidc/start": {
      "post": {
        "operationId": "startOidcLogin",
        "summary": "签发五分钟浏览器绑定与 S256 授权请求",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Start"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "无法验证登录"
          },
          "403": {
            "description": "Origin、账号或管理授权不符"
          },
          "404": {
            "description": "本部署未启用或账号不存在"
          },
          "409": {
            "description": "该企业身份已绑定"
          },
          "429": {
            "description": "登录次数超过限额"
          }
        }
      }
    },
    "/api/auth/oidc/complete": {
      "post": {
        "operationId": "completeOidcLogin",
        "summary": "单次消费 state 并验证企业 ID Token",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "__Host-cloide-oidc",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Exchange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "无法验证登录"
          },
          "403": {
            "description": "Origin、账号或管理授权不符"
          },
          "404": {
            "description": "本部署未启用或账号不存在"
          },
          "409": {
            "description": "该企业身份已绑定"
          },
          "429": {
            "description": "登录次数超过限额"
          }
        }
      }
    },
    "/api/admin/oidc/mappings/{userId}": {
      "put": {
        "operationId": "bindOidcSubject",
        "summary": "管理员登记已审核本地用户对应的企业 sub",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Binding"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "nullable": true
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "无法验证登录"
          },
          "403": {
            "description": "Origin、账号或管理授权不符"
          },
          "404": {
            "description": "本部署未启用或账号不存在"
          },
          "409": {
            "description": "该企业身份已绑定"
          },
          "429": {
            "description": "登录次数超过限额"
          }
        }
      },
      "delete": {
        "operationId": "unbindOidcSubject",
        "summary": "管理员撤销后续企业登录映射",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "nullable": true
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数无效"
          },
          "401": {
            "description": "无法验证登录"
          },
          "403": {
            "description": "Origin、账号或管理授权不符"
          },
          "404": {
            "description": "本部署未启用或账号不存在"
          },
          "409": {
            "description": "该企业身份已绑定"
          },
          "429": {
            "description": "登录次数超过限额"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Exchange": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 2048
          },
          "state": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "code",
          "state"
        ]
      },
      "Binding": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "subject"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ]
      },
      "Start": {
        "type": "object",
        "properties": {
          "authorizationUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "authorizationUrl"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "username": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "reviewStatus": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "username",
              "role",
              "reviewStatus"
            ]
          }
        },
        "required": [
          "token",
          "tokenType",
          "expiresIn",
          "user"
        ]
      }
    }
  }
}
