  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "owner",
              "developer",
              "viewer"
            ]
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "userId",
          "username",
          "role"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "developer",
              "viewer"
            ]
          }
        }
      },
      "Node": {
        "type": "object",
        "required": [
          "serverId",
          "name",
          "environment",
          "agentStatus"
        ],
        "properties": {
          "serverId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "dev",
              "test",
              "prod"
            ]
          },
          "agentStatus": {
            "type": "string",
            "description": "中控记录的 Agent 在线状态"
          }
        }
      },
      "CreateProject": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "MemberGrant": {
