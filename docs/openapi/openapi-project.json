{
  "openapi": "3.0.3",
  "info": {
    "title": "企业工程项目授权 API",
    "version": "1.0.0",
    "description": "创建项目同时登记 dev/test/prod 三个环境。非成员请求私有项目返回 404。节点仅由平台管理员分配，开发测试作业要求实际绑定了 dev 或 test 环境。"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/projects/{projectId}/nodes/{serverId}/capabilities": {
      "get": {
        "operationId": "getNodeJobCapabilities",
        "summary": "读取本项目可见的节点架构、资源和测试仓库",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "serverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "尚未报告时 reportedAt 为空，只返回分配给本项目的登记别名",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "os": {
                          "type": "string",
                          "nullable": true
                        },
                        "arch": {
                          "type": "string",
                          "nullable": true
                        },
                        "cpus": {
                          "type": "integer"
                        },
                        "diskFree": {
                          "type": "integer",
                          "format": "int64",
                          "nullable": true
                        },
                        "memoryAvailable": {
                          "type": "integer",
                          "format": "int64",
                          "nullable": true
                        },
                        "repositories": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "toolchains": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "reportedAt": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "项目或已分配节点不可见"
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "listEngineeringProjects",
        "summary": "列出自己有权读取的项目",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "仅返回数字 ID 大于游标的资源，按 ID 升序排列。",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        0
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数格式或角色无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "需要企业用户身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEngineeringProject",
        "summary": "新建工程项目并登记当前用户为所有者",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProject"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        0
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Project"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数格式或角色无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "需要企业用户身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
