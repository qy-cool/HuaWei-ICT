{
  "openapi": "3.0.3",
  "info": {
    "title": "项目制品、发布与节点证据",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/projects/{projectId}/artifacts": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "post": {
        "operationId": "uploadProjectArtifact",
        "summary": "上传原始制品字节并关联成功作业，按作业、类型、摘要幂等",
        "parameters": [
          {
            "name": "runId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "java-jar",
                "static-tar"
              ]
            }
          },
          {
            "name": "X-Content-SHA256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Artifact"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数、大小或内容摘要无效"
          },
          "401": {
            "description": "身份认证失败"
          },
          "403": {
            "description": "权限或节点分配不足"
          },
          "404": {
            "description": "指定范围内未找到资源"
          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      },
      "get": {
        "operationId": "listProjectArtifacts",
        "summary": "按项目列出最近 100 项制品",
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Artifact"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数、大小或内容摘要无效"
          },
          "401": {
            "description": "身份认证失败"
          },
          "403": {
            "description": "权限或节点分配不足"
          },
          "404": {
            "description": "指定范围内未找到资源"
          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      }
    },
    "/api/projects/{projectId}/artifacts/{artifactId}/content": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "artifactId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "downloadProjectArtifact",
        "summary": "校验登记大小及摘要后返回原始字节",
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "参数、大小或内容摘要无效"
          },
          "401": {
            "description": "身份认证失败"
          },
          "403": {
            "description": "权限或节点分配不足"
          },
          "404": {
            "description": "指定范围内未找到资源"
          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      }
    },
    "/api/projects/{projectId}/environments/{environment}/releases": {
      "parameters": [
        {
