          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      }
    },
    "/api/projects/{projectId}/environments/{environment}/releases/{releaseId}/events": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "environment",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "dev",
              "test",
              "prod"
            ]
          }
        },
        {
          "name": "releaseId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "listReleaseEvidence",
        "summary": "按游标先后列出发布审计事件",
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReleaseEvent"
                      }
                    }
                  },
                  "required": [
