            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      }
    },
    "/api/release-agent/next": {
      "get": {
        "operationId": "claimNodeRelease",
        "summary": "节点认领待执行发布；无可认领任务时 data 为 null。三个筛选项须一起提供或一起省略",
        "security": [
          {
            "nodeToken": []
          }
        ],
        "parameters": [
          {
            "name": "serverId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "dev",
                "test",
                "prod"
              ]
            }
          },
          {
            "name": "service",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Release"
                        }
                      ],
                      "nullable": true
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数、大小或内容摘要无效"
          },
          "401": {
            "description": "身份认证失败"
          },
          "403": {
            "description": "权限或节点分配不足"
          },
          "404": {
            "description": "指定范围内未找到资源"
          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      }
    },
    "/api/release-agent/{releaseId}/content": {
      "parameters": [
        {
          "name": "releaseId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "pullNodeReleaseBytes",
        "summary": "授权目标节点下载已认领版本",
        "security": [
          {
            "nodeToken": []
          }
        ],
        "parameters": [
          {
            "name": "serverId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "参数、大小或内容摘要无效"
          },
          "401": {
            "description": "身份认证失败"
          },
          "403": {
            "description": "权限或节点分配不足"
          },
          "404": {
            "description": "指定范围内未找到资源"
          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      }
    },
    "/api/release-agent/{releaseId}/receipt": {
      "parameters": [
        {
          "name": "releaseId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "confirmNodeRelease",
        "summary": "持久记录节点回执；完全相同的终态重放可重新确认",
        "security": [
          {
            "nodeToken": []
          }
        ],
        "parameters": [
          {
            "name": "serverId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Receipt"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "nullable": true
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数、大小或内容摘要无效"
          },
          "401": {
            "description": "身份认证失败"
          },
          "403": {
            "description": "权限或节点分配不足"
          },
          "404": {
            "description": "指定范围内未找到资源"
          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "nodeToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Agent-Token"
      }
    },
    "schemas": {
      "Artifact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "integer",
            "format": "int64"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "repository": {
            "type": "string"
          },
          "commitSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "java-jar",
              "static-tar"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteCount": {
            "type": "integer",
            "format": "int64"
          },
          "sourceNodeId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "已认证、实际产生制品的构建节点；人工上传为 null。"
          },
          "uploadedBy": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "description": "UTC DATETIME，精确至微秒"
          }
        },
        "required": [
          "id",
          "projectId",
          "runId",
          "repository",
          "commitSha",
          "kind",
          "sha256",
          "byteCount",
          "uploadedBy",
          "createdAt"
        ]
      },
      "Release": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "integer",
            "format": "int64"
          },
          "environment": {
            "type": "string",
            "enum": [
              "dev",
              "test",
              "prod"
            ]
          },
          "service": {
            "type": "string"
          },
          "serverId": {
            "type": "integer",
            "format": "int64"
          },
          "generation": {
            "type": "integer",
            "format": "int64"
          },
          "action": {
            "type": "string",
            "enum": [
              "deploy",
              "rollback"
            ]
          },
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "java-jar",
              "static-tar"
            ]
          },
