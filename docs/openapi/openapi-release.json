            ]
          }
        },
        {
          "name": "releaseId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "cancelQueuedRelease",
        "summary": "取消尚未认领的发布",
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
