              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Release"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数、大小或内容摘要无效"
          },
          "401": {
            "description": "身份认证失败"
          },
          "403": {
            "description": "权限或节点分配不足"
          },
          "404": {
            "description": "指定范围内未找到资源"
          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      },
      "get": {
        "operationId": "listEnvironmentReleases",
        "summary": "查看最近 100 次发布及实际节点证据",
        "responses": {
          "200": {
            "description": "已完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Release"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数、大小或内容摘要无效"
          },
          "401": {
            "description": "身份认证失败"
          },
          "403": {
            "description": "权限或节点分配不足"
          },
          "404": {
            "description": "指定范围内未找到资源"
          },
          "409": {
            "description": "状态冲突、数据损坏、幂等冲突或未满足提升条件"
          }
        }
      }
    },
    "/api/projects/{projectId}/environments/{environment}/releases/{releaseId}/rollback": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
