{
  "openapi": "3.0.3",
  "info": {
    "title": "cloide-shell Authentication API",
    "description": "cloide-shell authentication API for Apifox import and local testing.",
    "version": "0.3.0"
  },
  "servers": [
    {
      "url": "http://localhost:18080",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Authentication and registration"
    }
  ],
  "paths": {
    "/api/auth/bootstrap-status": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Bootstrap status",
        "description": "Public endpoint returning whether the system still awaits its first admin. When bootstrapPending is true, POST /api/auth/register requires a valid one-time bootstrap token (40310 when missing, 40311 when invalid); the token is delivered to operators via the server startup log banner or the AUTH_BOOTSTRAP_TOKEN environment variable. After the first admin exists, registration no longer requires the token.",
        "operationId": "getBootstrapStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Bootstrap status snapshot",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapStatusResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "bootstrapPending": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register user",
        "description": "Registers a user. When the system still awaits its first admin (bootstrapPending=true on GET /api/auth/bootstrap-status), a valid one-time bootstrap token must be provided in bootstrapToken; the token is consumed on success and the first user becomes admin/approved. Missing token returns 403/40310 and an invalid token returns 403/40311. After the first admin exists, subsequent users become user/pending and bootstrapToken is ignored. X-Request-ID is generated by the server; a valid X-Correlation-ID is echoed in the response.",
        "operationId": "registerUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "username": "admin",
                "password": "REPLACE_WITH_PASSWORD"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 40002,
                  "message": "invalid request parameter",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "Username already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 40900,
                  "message": "resource conflict",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "Bootstrap token required (40310) or invalid (40311) while the system still awaits its first admin",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 40310,
                  "message": "bootstrap token required",
                  "data": null
                }
              }
            }
          },
          "429": {
            "description": "Registration rate limit exceeded (42905). Retry after the number of seconds in Retry-After.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Retry-After": {
                "description": "Seconds until another registration attempt is allowed.",
                "schema": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 42905,
                  "message": "login rate limit reached",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Authenticates credentials and returns a JWT for approved users. Cache-Control: no-store is set on the response. A rate-limited client receives HTTP 429 with code 42905 and Retry-After.",
        "operationId": "loginUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "admin",
                "password": "REPLACE_WITH_PASSWORD"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Cache-Control": {
                "description": "Always 'no-store' to prevent caching of the JWT.",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "token": "REPLACE_WITH_JWT",
                    "tokenType": "Bearer",
                    "expiresIn": 259200,
                    "user": {
                      "id": 1,
                      "username": "admin",
                      "role": "admin",
                      "reviewStatus": "approved",
                      "reviewedAt": "2026-07-20T00:00:00Z",
                      "createdAt": "2026-07-20T00:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequestParameter"
          },
          "401": {
            "description": "Invalid username or password (40001)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 40001,
                  "message": "invalid username or password",
                  "data": null
                }
              }
            }
          },
          "429": {
            "description": "Login rate limit exceeded (42905). Retry after the number of seconds in Retry-After.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Retry-After": {
                "description": "Seconds until another login attempt is allowed.",
                "schema": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 42905,
                  "message": "login rate limit reached",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "User is not yet approved (40300)",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 40300,
                  "message": "forbidden",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current user",
        "description": "Returns the latest database snapshot of the authenticated user. The server re-queries the database on every call.",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current user snapshot",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Bearer-authenticated logout. When Redis is enabled, the current JWT jti is added to the Redis blacklist with the token's remaining TTL and becomes invalid across instances; when Redis is disabled, logout is a stateless no-op and the client must delete its local JWT (documented single-instance semantics, 2026-09-14 security review decision 2). If the blacklist write hits a Redis failure, the response follows cloide.security.token-blacklist-on-error: fail_closed (default) returns HTTP 503 with code 50302 and the client should retry; fail_open acknowledges logout and logs a warning (the token stays valid until natural expiry).",
        "operationId": "logoutUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Logout acknowledged",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/XCorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                },
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": null
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "description": "Redis unavailable while failing closed (50302)",
            "content": {
              "application/json": {
                "example": {
                  "code": 50302,
                  "message": "redis unavailable",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "XRequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Client-provided value is ignored; the server generates a UUID request ID for every response.",
        "schema": {
          "type": "string"
        }
      },
      "XCorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "description": "Optional client correlation ID. Invalid values are ignored and never logged.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "UUID request ID generated by the server.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "XCorrelationId": {
        "description": "Validated client correlation ID, returned only when a valid request header was provided.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid, or expired JWT (40100)",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestId"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/XCorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 40100,
              "message": "unauthorized",
              "data": null
            }
          }
        }
      },
      "InvalidRequestParameter": {
        "description": "Invalid request parameter (40002)",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestId"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/XCorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": 40002,
              "message": "invalid request parameter",
              "data": null
            }
          }
        }
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 64,
            "writeOnly": true
          },
          "bootstrapToken": {
            "type": "string",
            "format": "password",
            "minLength": 32,
            "maxLength": 128,
            "writeOnly": true,
            "description": "One-time bootstrap token required only while the system still awaits its first admin. Delivered via the server startup log banner or AUTH_BOOTSTRAP_TOKEN. Ignored after the first admin exists."
          }
        }
      },
      "BootstrapStatus": {
        "type": "object",
        "required": [
          "bootstrapPending"
        ],
        "properties": {
          "bootstrapPending": {
            "type": "boolean",
            "description": "True when the system still awaits its first admin and registration requires a one-time bootstrap token."
          }
        }
      },
      "BootstrapStatusResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/BootstrapStatus"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 64,
            "writeOnly": true
          }
        }
      },
      "LoginVo": {
        "type": "object",
        "required": [
          "token",
          "tokenType",
          "expiresIn",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT bearer token. Never logged or returned by other endpoints."
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "Token lifetime in seconds."
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/LoginVo"
          }
        }
      },
      "EmptyResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "nullable": true
          }
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "reviewStatus",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "user"
            ]
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          }
        }
      }
    }
  }
}
