  "paths": {
    "/api/projects/{projectId}/repositories": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "get": {
        "operationId": "listConnectedRepositories",
        "summary": "返回该项目的授权连接",
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Repository"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      },
      "post": {
        "operationId": "generateProjectRepository",
        "summary": "管理员在企业组织中从指定模板创建私有仓库",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "name",
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Repository"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
