                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "上游数据异常"
          },
          "503": {
            "description": "服务暂不可用"
          }
        }
      }
    },
    "/api/integrations/github/webhook": {
      "post": {
        "operationId": "receiveSignedGitHubDelivery",
        "summary": "校验最初收到的原始字节、GitHub 安装及交付 ID，记录 PR 状态与移除授权",
        "security": [],
        "parameters": [
          {
            "name": "X-GitHub-Event",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-GitHub-Delivery",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "nullable": true
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Repository": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer",
            "format": "int64"
          },
          "remoteId": {
            "type": "integer",
            "format": "int64"
          },
          "ownerName": {
            "type": "string"
          },
          "repoName": {
            "type": "string"
          },
          "defaultBranch": {
            "type": "string"
          },
          "installationId": {
            "type": "integer",
            "format": "int64"
          },
          "linkedBy": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "projectId",
          "remoteId",
          "ownerName",
          "repoName",
          "defaultBranch",
          "installationId",
          "linkedBy"
        ]
      },
      "Pull": {
        "type": "object",
        "properties": {
          "remoteId": {
            "type": "integer",
            "format": "int64"
          },
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "prNumber": {
            "type": "integer",
            "format": "int64"
          },
          "headSha": {
            "type": "string"
          },
          "baseSha": {
            "type": "string"
          },
          "prState": {
            "type": "string"
          },
          "requestedBy": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "remoteId",
          "taskId",
          "prNumber",
          "headSha",
          "baseSha",
          "prState",
          "requestedBy"
        ]
      },
      "SourcePolicy": {
        "type": "object",
        "description": "仓库允许来源策略；版本 0 为隐式默认（仅登记时默认分支），不落库",
        "properties": {
          "repositoryId": {
            "type": "integer",
            "format": "int64"
          },
          "policyVersion": {
            "type": "integer",
            "format": "int64"
          },
          "allowedRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "repositoryId",
          "policyVersion",
          "allowedRefs"
        ]
      },
      "RefPage": {
        "type": "object",
        "description": "读时观察结果；commitSha 为 null 表示远端分支已不存在",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "commitSha": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "ref"
              ]
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items"
        ]
      },
      "SourceSnapshot": {
        "type": "object",
        "description": "不可变提交快照；bindingActive=false 表示绑定已撤销，仅供审计",
        "properties": {
          "snapshotId": {
            "type": "string",
            "format": "uuid"
          },
          "repositoryId": {
            "type": "integer",
            "format": "int64"
          },
          "ref": {
            "type": "string"
          },
          "commitSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "treeSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "bindingGeneration": {
            "type": "integer",
            "format": "int64"
          },
          "policyVersion": {
            "type": "integer",
            "format": "int64"
          },
          "resolvedAt": {
            "type": "string"
          },
          "createdBy": {
            "type": "integer",
            "format": "int64"
          },
          "bindingActive": {
            "type": "boolean"
          }
        },
        "required": [
          "snapshotId",
          "repositoryId",
          "ref",
          "commitSha",
          "treeSha",
          "bindingGeneration",
          "policyVersion",
          "resolvedAt",
          "createdBy",
          "bindingActive"
        ]
      }
    }
  }
}
