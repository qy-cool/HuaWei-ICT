{
  "openapi": "3.0.3",
  "info": {
    "title": "GitHub App 仓库、任务 PR 与 Webhook",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/projects/{projectId}/repositories": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "get": {
        "operationId": "listConnectedRepositories",
        "summary": "返回该项目的授权连接",
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Repository"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      },
      "post": {
        "operationId": "generateProjectRepository",
        "summary": "管理员在企业组织中从指定模板创建私有仓库",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "name",
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Repository"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
    "/api/projects/{projectId}/repositories/import": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "post": {
        "operationId": "importGitHubRepository",
        "summary": "管理员导入已授权仓库",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Repository"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
    "/api/projects/{projectId}/repositories/{repositoryId}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "repositoryId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "delete": {
        "operationId": "unlinkGitHubRepository",
        "summary": "管理员撤销本平台项目连接",
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "nullable": true
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
    "/api/projects/{projectId}/repositories/{repositoryId}/pulls": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "repositoryId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "get": {
        "operationId": "listTaskPulls",
        "summary": "列出最近 100 个任务 PR",
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pull"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      },
      "post": {
        "operationId": "publishTaskPull",
        "summary": "为可审查任务发布新分支和 PR；同任务可恢复",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "taskId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "taskId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pull"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
    "/api/integrations/github/webhook": {
      "post": {
        "operationId": "receiveSignedGitHubDelivery",
        "summary": "校验最初收到的原始字节、GitHub 安装及交付 ID，记录 PR 状态与移除授权",
        "security": [],
        "parameters": [
          {
            "name": "X-GitHub-Event",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-GitHub-Delivery",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "nullable": true
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证或 HMAC-SHA-256 签名校验失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "远端分支、任务内容或交付标识发生冲突"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Repository": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer",
            "format": "int64"
          },
          "remoteId": {
            "type": "integer",
            "format": "int64"
          },
          "ownerName": {
            "type": "string"
          },
          "repoName": {
            "type": "string"
          },
          "defaultBranch": {
            "type": "string"
          },
          "installationId": {
            "type": "integer",
            "format": "int64"
          },
          "linkedBy": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "projectId",
          "remoteId",
          "ownerName",
          "repoName",
          "defaultBranch",
          "installationId",
          "linkedBy"
        ]
      },
      "Pull": {
        "type": "object",
        "properties": {
          "remoteId": {
            "type": "integer",
            "format": "int64"
          },
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "prNumber": {
            "type": "integer",
            "format": "int64"
          },
          "headSha": {
            "type": "string"
          },
          "baseSha": {
            "type": "string"
          },
          "prState": {
            "type": "string"
          },
          "requestedBy": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "remoteId",
          "taskId",
          "prNumber",
          "headSha",
          "baseSha",
          "prState",
          "requestedBy"
        ]
      }
    }
  }
}
