    "/api/projects/{projectId}/repositories/{repositoryId}/source-policy": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "repositoryId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "put": {
        "operationId": "updateRepositorySourcePolicy",
        "summary": "平台管理员设置允许分支清单；expectedPolicyVersion 乐观并发，同 requestId 重放返回原版本",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expectedPolicyVersion": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "allowedRefs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "requestId",
                  "expectedPolicyVersion",
                  "allowedRefs"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SourcePolicy"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效或 ref 不在允许格式（40005）"
          },
          "401": {
            "description": "认证失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "策略版本乐观锁冲突或幂等键参数不符（40908）"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
