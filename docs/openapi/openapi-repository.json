    "/api/projects/{projectId}/repositories/{repositoryId}/snapshots": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "repositoryId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "post": {
        "operationId": "createSourceSnapshot",
        "summary": "项目开发者把允许分支钉住为不可变提交快照；expectedCommitSha 不符返回 40907 并携带当前实际 SHA",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ref": {
                    "type": "string",
                    "example": "refs/heads/main"
                  },
                  "expectedCommitSha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                },
                "required": [
                  "requestId",
                  "ref"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SourceSnapshot"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效或 ref 不在允许清单（40005）"
          },
          "401": {
            "description": "认证失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到，或远端分支不存在（40405）"
          },
          "409": {
            "description": "分支前移（40907，data 携带 currentCommitSha）或幂等键参数冲突（40908）"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
