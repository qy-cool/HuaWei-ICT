    "/api/projects/{projectId}/repositories/{repositoryId}/source-policy": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "repositoryId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "put": {
        "operationId": "updateRepositorySourcePolicy",
        "summary": "平台管理员设置允许分支清单；expectedPolicyVersion 乐观并发，同 requestId 重放返回原版本",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expectedPolicyVersion": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  },
                  "allowedRefs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "requestId",
                  "expectedPolicyVersion",
                  "allowedRefs"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SourcePolicy"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效或 ref 不在允许格式（40005）"
          },
          "401": {
            "description": "认证失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "策略版本乐观锁冲突或幂等键参数不符（40908）"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
    "/api/projects/{projectId}/repositories/{repositoryId}/refs": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "repositoryId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        }
      ],
      "get": {
        "operationId": "listRepositoryRefs",
        "summary": "读时观察：列出当前允许分支及其提交 SHA；分支可能随时前移",
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/RefPage"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效"
          },
          "401": {
            "description": "认证失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到"
          },
          "409": {
            "description": "上游数据异常"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
    "/api/projects/{projectId}/repositories/{repositoryId}/snapshots": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "repositoryId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "post": {
        "operationId": "createSourceSnapshot",
        "summary": "项目开发者把允许分支钉住为不可变提交快照；expectedCommitSha 不符返回 40907 并携带当前实际 SHA",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ref": {
                    "type": "string",
                    "example": "refs/heads/main"
                  },
                  "expectedCommitSha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                },
                "required": [
                  "requestId",
                  "ref"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/SourceSnapshot"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "输入无效或 ref 不在允许清单（40005）"
          },
          "401": {
            "description": "认证失败"
          },
          "403": {
            "description": "范围或角色不允许操作"
          },
          "404": {
            "description": "资源未找到，或远端分支不存在（40405）"
          },
          "409": {
            "description": "分支前移（40907，data 携带 currentCommitSha）或幂等键参数冲突（40908）"
          },
          "503": {
            "description": "GitHub App 未配置或远端服务暂时不可用"
          }
        }
      }
    },
    "/api/projects/{projectId}/snapshots/{snapshotId}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "snapshotId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getSourceSnapshot",
        "summary": "项目可读；跨项目请求 404 且不暴露仓库或 ref 信息；绑定撤销后仍可审计",
        "responses": {
          "200": {
            "description": "操作成功",
