# cloide-shell 环境变量模板。
# 用法：cp .env.example .env 后填写；或
#   docker compose --env-file <path> up -d
# .env / .env.* 已被 .gitignore 排除，严禁提交任何真实值。
# 密钥生成（Linux/WSL/Git Bash）：
#   JWT_SECRET  : openssl rand -base64 32   （≥32 字节，Base64）
#   AES_GCM_KEY : openssl rand -base64 32   （恰好 32 字节，Base64）
#   MYSQL_ROOT_PASSWORD / DB_PASSWORD / RABBITMQ_PASSWORD：openssl rand -hex 16

# ---------- 必填（缺失时 compose 直接报错） ----------
MYSQL_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
JWT_SECRET=change-me
AES_GCM_KEY=change-me

# ---------- 数据库 / 队列默认值 ----------
DB_NAME=cloide
DB_USER=cloide
# DB_USE_SSL=false
RABBITMQ_USER=cloide
RABBITMQ_VHOST=cloide

# ---------- 服务与告警 ----------
APP_NAME=cloide
OUTBOX_ENABLED=true
ALERT_NOTIFICATION_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
ALERT_MAIL_FROM=noreply@cloide.local
AGENT_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# 当前没有 Web 前端；接入浏览器端时填实际来源（逗号分隔，不含路径）。
CORS_ALLOWED_ORIGINS=

# ---------- Redis（多实例 ticket 共享；默认关闭） ----------
REDIS_ENABLED=false
REDIS_PASSWORD=
REDIS_TICKET_TTL_SECONDS=30

# ---------- 首管理员一次性初始化令牌 ----------
# 预置时须 32-128 字符；留空则首管理员未初始化时启动自动生成并经启动横幅投递。
# 令牌消费后立即失效；已初始化实例不再读取。严禁提交真实值。
AUTH_BOOTSTRAP_TOKEN=

# ---------- AI（默认全关；接华为云 MaaS 时填 OpenAI 兼容 endpoint） ----------
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOW_INSECURE_HTTP=false
AI_QA_ENABLED=false
AI_EXPLANATION_ENABLED=false
AI_COMMAND_ENABLED=false
AI_REPORT_ENABLED=false

# ---------- 仅 agent profile（docker compose --profile agent） ----------
CLOIDE_BACKEND_URL=ws://server:18080
CLOIDE_SERVER_ID=change-me
CLOIDE_AGENT_TOKEN=change-me
CLOIDE_TERMINAL_ENABLED=false
